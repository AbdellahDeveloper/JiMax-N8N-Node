{
  "name": "n8n-nodes-jimax-llm",
  "version": "1.0.1",
  "description": "n8n nodes for LLM interaction using Vercel AI SDK",
  "license": "MIT",
  "homepage": "",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "JiMax",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdellahDeveloper/n8n-nodes-jimax-llm.git"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "files": [
    "dist",
    "icons"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/OpenAiSdkApi.credentials.js",
      "dist/credentials/GoogleSdkApi.credentials.js",
      "dist/credentials/AnthropicSdkApi.credentials.js",
      "dist/credentials/OpenAiCompatibleSdkApi.credentials.js",
      "dist/credentials/UpstashSearchApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JiMaxLLM/JiMaxTextLLM.node.js",
      "dist/nodes/JiMaxLLM/JiMaxObjectLLM.node.js",
      "dist/nodes/JiMaxLLM/JiMaxObjectToolLLM.node.js",
      "dist/nodes/UpstashSearch/UpstashSearch.node.js",
      "dist/nodes/ReservationPdf/ReservationPdf.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.0.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/openai-compatible": "^2.0.45",
    "@upstash/search": "^0.1.7",
    "ai": "^6.0.174",
    "pdfkit": "^0.19.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.2"
  }
}
